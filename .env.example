# The MCP service runs separately from Dockge; it does not mount a Docker socket.
DOCKGE_URL=http://dockge:5001
DOCKGE_PROFILE=1.5.0
DOCKGE_USERNAME=replace-me
DOCKGE_PASSWORD=replace-me
# Alternatively configure a previously issued Dockge JWT:
# DOCKGE_JWT=
MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
HOST=0.0.0.0
PORT=3000
# Exact host:port values used by your hub and container health check.
MCP_ALLOWED_HOSTS=dockge-mcp:3000,localhost:3000,127.0.0.1:3000
# Browser origins are rejected unless explicitly listed; a server-side hub needs none.
MCP_ALLOWED_ORIGINS=
# Empty permits the primary and all registered agents. Discover IDs with list_agents.
DOCKGE_ALLOWED_AGENTS=
DOCKGE_ALLOW_WRITE=false
DOCKGE_ALLOW_DELETE=false
DOCKGE_ALLOW_ENV_READ=false
DOCKGE_ALLOW_ENV_WRITE=false
STATE_DIR=/data
DOCKGE_READ_TIMEOUT_MS=10000
DOCKGE_MUTATION_TIMEOUT_MS=120000
