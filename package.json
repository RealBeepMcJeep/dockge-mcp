{
  "name": "dockge-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "bun src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
