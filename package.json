  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "socket.io-client": "4.8.4",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "socket.io": "4.8.4",
    "typescript": "5.9.3"
  }
}
